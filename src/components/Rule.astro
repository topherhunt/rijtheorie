---
import { citeLinks } from '../lib/questions.ts';

interface Props { cite: string; title?: string }
const { cite, title } = Astro.props;
const links = citeLinks(cite.split(','));
---

<aside class="qa-rule my-5 rounded-lg border-l-4 border-blue-600 bg-blue-50 px-4 py-3">
  {title && <p class="mb-1 font-semibold text-blue-950">{title}</p>}
  <div class="[&>p]:my-1"><slot /></div>
  <p class="mt-2 text-xs text-blue-900">
    Fuente:
    {links.map((l, i) => <>{i > 0 && '; '}<a class="qa-cite underline" href={l.url} target="_blank" rel="noopener">{l.label}</a></>)}
  </p>
</aside>
