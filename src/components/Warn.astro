---
interface Props { title?: string }
const { title = 'Error frecuente' } = Astro.props;
---

<aside class="qa-warn my-5 rounded-lg border-l-4 border-red-600 bg-red-50 px-4 py-3">
  <p class="mb-1 font-semibold text-red-950"><i class="bi bi-exclamation-triangle-fill mr-1" aria-hidden="true"></i>{title}</p>
  <div class="[&>p]:my-1"><slot /></div>
</aside>
