---
interface Props { title?: string }
const { title = 'Consejo para el examen' } = Astro.props;
---

<aside class="qa-tip my-5 rounded-lg border-l-4 border-emerald-600 bg-emerald-50 px-4 py-3">
  <p class="mb-1 font-semibold text-emerald-950"><i class="bi bi-lightbulb-fill mr-1" aria-hidden="true"></i>{title}</p>
  <div class="[&>p]:my-1"><slot /></div>
</aside>
