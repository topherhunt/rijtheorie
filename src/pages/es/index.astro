---
import Layout from '../../layouts/Layout.astro';
import ChapterTable from '../../components/ChapterTable.tsx';
import { chapters } from '../../lib/data.ts';
import { lessons } from '../../lib/lessons.ts';
import { questionsByLesson } from '../../lib/questions.ts';
import { REPO_URL, SITE_NAME, href } from '../../config.ts';

const all = await lessons('es');
const byLesson = await questionsByLesson();
---

<Layout title={SITE_NAME} description="Curso gratuito y no oficial para el examen teórico de coche (rijbewijs B) en los Países Bajos, en español.">
  <h1 class="text-3xl font-bold">Examen teórico de coche en los Países Bajos</h1>
  <p class="mt-3 text-lg text-slate-700">
    Un curso gratuito en español para preparar el <i lang="nl">theorie-examen auto</i> del CBR. Aprendes las reglas en español y, al mismo tiempo, las palabras en neerlandés que vas a ver en el examen.
  </p>
  <div class="qa-disclaimer mt-4 rounded-lg border border-amber-300 bg-amber-100 p-4 text-amber-900" role="note">
    <p><i class="bi bi-exclamation-triangle-fill mr-1" aria-hidden="true"></i> Este curso <strong>no es oficial</strong> ni del CBR, y puede tener errores. Estúdialo junto con material oficial; el examen es en neerlandés o inglés. Cada regla enlaza a su fuente. <a class="qa-home-report font-semibold whitespace-nowrap underline" href={`${REPO_URL}/issues/new?template=problema.yml`} target="_blank" rel="noopener">Reporta un error</a> · <a class="qa-home-about font-semibold whitespace-nowrap underline" href={href('es/acerca/')}>Acerca del curso</a></p>
  </div>

  <ol class="qa-chapters mt-8 flex flex-col gap-6">
    {chapters().map((c) => {
      const rows = all.filter((l) => l.chapter.id === c.id).map((l) => ({
        id: l.id,
        title: l.entry.data.title,
        href: href(l.path),
        qids: (byLesson.get(l.id) ?? []).map((q) => q.id), // a lesson without a quiz file shows 0 / 0
      }));
      return (
        <li id={c.id} class="qa-chapter rounded-xl border border-slate-200 bg-white p-4">
          <h2 class="text-xl font-bold"><span class="text-slate-400">{c.n}.</span> {c.title}</h2>
          <p class="mt-1 text-slate-600">{c.summary}</p>
          {rows.length > 0 ? <ChapterTable client:idle rows={rows} /> : <p class="mt-3 text-sm italic text-slate-400">Próximamente</p>}
        </li>
      );
    })}
  </ol>
</Layout>
