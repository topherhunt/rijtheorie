---
import Layout from '../../layouts/Layout.astro';
import { glossary } from '../../lib/data.ts';
import { citeLinks } from '../../lib/questions.ts';

const terms = Object.entries(glossary()).sort(([, a], [, b]) => a.nl.localeCompare(b.nl, 'nl'));
---

<Layout title="Glosario neerlandés-español">
  <h1 class="text-3xl font-bold">Glosario neerlandés-español</h1>
  <p class="mt-2 text-slate-600">
    Las palabras del examen del CBR y de las clases de manejo. <span class="font-semibold">CBR</span> = aparece en la lista oficial de palabras del examen. <span class="font-semibold">NL</span> = el CBR no la traduce nunca, ni con intérprete.
  </p>
  <input id="glossary-filter" type="search" placeholder="Buscar…" class="qa-glossary-filter mt-4 w-full rounded-lg border border-slate-300 px-3 py-2" />
  <dl class="qa-glossary mt-6 flex flex-col gap-3">
    {terms.map(([id, t]) => (
      <div id={id} class="qa-glossary-term rounded-lg border border-slate-200 bg-white p-3" data-search={`${t.nl} ${t.es}`.toLowerCase()}>
        <dt>
          <i lang="nl" class="font-semibold text-brand-700">{t.nl}</i>
          <span class="mx-1 text-slate-400">·</span>
          <span>{t.es}</span>
          {t.cbr && <span class="ml-2 rounded bg-slate-100 px-1 text-xs font-semibold text-slate-600">CBR</span>}
          {t.untranslated && <span class="ml-1 rounded bg-amber-100 px-1 text-xs font-semibold text-amber-800">NL</span>}
        </dt>
        {t.def && (
          <dd class="mt-1 text-sm text-slate-700">
            {t.def}
            {t.cite && <span class="text-xs text-slate-500"> ({citeLinks(t.cite.split(',')).map((l, i) => <>{i > 0 && '; '}<a class="underline" href={l.url} target="_blank" rel="noopener">{l.label}</a></>)})</span>}
          </dd>
        )}
      </div>
    ))}
  </dl>
  <script>
    const input = document.getElementById('glossary-filter') as HTMLInputElement;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const el of document.querySelectorAll<HTMLElement>('.qa-glossary-term')) el.hidden = !!q && !el.dataset.search!.includes(q);
    });
  </script>
</Layout>
