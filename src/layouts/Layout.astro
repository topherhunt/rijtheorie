---
import 'bootstrap-icons/font/bootstrap-icons.min.css';
import '../styles/global.css';
import { REPO_URL, SITE_NAME, href } from '../config.ts';
import { es } from '../i18n/es.ts';

interface Props { title: string; description?: string }
const { title, description } = Astro.props;
const reportUrl = `${REPO_URL}/issues/new?template=problema.yml&url=${encodeURIComponent(Astro.url.pathname)}`;
const nav = [
  ['es/', es.nav.home, 'bi-book'],
  ['es/repaso/', es.nav.review, 'bi-arrow-repeat'],
  ['es/examen/', es.nav.exam, 'bi-clipboard-check'],
  ['es/notas/', es.nav.notes, 'bi-journal-text'],
  ['es/glosario/', es.nav.glossary, 'bi-translate'],
  ['es/progreso/', es.nav.progress, 'bi-graph-up'],
  ['es/acerca/', es.nav.about, 'bi-info-circle'],
] as const;
// Longest matching prefix wins, so lesson pages (under /es/<chapter>/) highlight "Curso".
const current = nav.map(([p]) => href(p)).filter((p) => Astro.url.pathname.startsWith(p)).sort((a, b) => b.length - a.length)[0];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === SITE_NAME ? title : `${title} | ${SITE_NAME}`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <script is:inline>
      // Before first paint, so the page never flashes the wrong theme. No stored choice: follow the OS.
      let theme = null;
      try { theme = localStorage.getItem('rijtheorie:theme'); } catch {}
      document.documentElement.dataset.theme = theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
        <a href={href('es/')} class="font-bold text-brand-700">{SITE_NAME}</a>
        <button type="button" id="theme-toggle" class="qa-theme-toggle ml-auto rounded-lg px-2 py-1 text-lg text-slate-600 hover:bg-slate-100" aria-label={es.theme}>
          <i class="bi bi-moon-fill dark:hidden" aria-hidden="true"></i><i class="bi bi-sun-fill hidden dark:inline" aria-hidden="true"></i>
        </button>
        <nav class="flex w-full flex-wrap gap-x-3 gap-y-3 text-sm sm:gap-y-1">
          {nav.map(([p, label, icon]) => {
            const active = href(p) === current;
            return <a class:list={['qa-nav-link hover:text-brand-700', active ? 'qa-nav-active font-semibold text-brand-700 underline decoration-2 underline-offset-6' : 'text-slate-600']} aria-current={active ? 'page' : undefined} href={href(p)}><i class={`bi ${icon} mr-1`} aria-hidden="true"></i>{label}</a>;
          })}
        </nav>
      </div>
    </header>
    <div id="storage-banner" class="qa-storage-banner hidden bg-red-100 px-4 py-2 text-center text-sm text-red-900">{es.storage}</div>
    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto flex max-w-4xl flex-col gap-2 px-4 py-6 text-sm text-slate-600">
        <a class="qa-report-link tooltip self-start font-semibold text-brand-700 underline" data-tip={es.reportHint} href={reportUrl} target="_blank" rel="noopener"><i class="bi bi-flag mr-1" aria-hidden="true"></i>{es.report}</a>
      </div>
    </footer>
    <script>
      try {
        localStorage.setItem('rijtheorie:probe', '1');
        localStorage.removeItem('rijtheorie:probe');
      } catch {
        document.getElementById('storage-banner')!.classList.remove('hidden');
      }
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const root = document.documentElement;
        // .theme-fade (global.css) transitions colors only while switching, so hovers elsewhere stay instant.
        root.classList.add('theme-fade');
        setTimeout(() => root.classList.remove('theme-fade'), 500);
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('rijtheorie:theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
